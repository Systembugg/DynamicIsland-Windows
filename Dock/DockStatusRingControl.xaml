<UserControl x:Class="DynamicIsland.Dock.DockStatusRingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="20"
             RenderOptions.BitmapScalingMode="HighQuality"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Subpixel Background Ring -->
        <Ellipse Width="18" Height="18" Stroke="#250A84FF" StrokeThickness="2.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Dynamic Status Progress Arc (Blue on Docked, Green on Used) -->
        <Path x:Name="RingArcPath" Stroke="#0A84FF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- Center Container: Count Number / Checkmark -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Docked Items Count Number (e.g. 1, 2, 3, 9+) -->
            <TextBlock x:Name="TxtDockCount" Text="1" Foreground="#0A84FF" FontSize="9" FontWeight="Bold" FontFamily="SF Mono, SF Pro Display, Consolas, Segoe UI" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-0.5,0,0"/>

            <!-- Green Mode: Checkmark (✓) -->
            <Path x:Name="GreenCheckmark" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" Fill="#30D158" Width="9" Height="9" Stretch="Uniform" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
