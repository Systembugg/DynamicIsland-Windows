<UserControl x:Class="DynamicIsland.Call.CallWaveformControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Height="16" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- 7 Green Bars (#37C058) -->
        <Border x:Name="Bar0" Width="1.6" Height="4" CornerRadius="0.8" Background="#37C058" Margin="0,0,1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar1" Width="1.6" Height="8" CornerRadius="0.8" Background="#37C058" Margin="0,0,1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar2" Width="1.6" Height="12" CornerRadius="0.8" Background="#37C058" Margin="0,0,1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar3" Width="1.6" Height="14" CornerRadius="0.8" Background="#37C058" Margin="0,0,1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar4" Width="1.6" Height="10" CornerRadius="0.8" Background="#37C058" Margin="0,0,1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar5" Width="1.6" Height="8" CornerRadius="0.8" Background="#37C058" Margin="0,0,1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar6" Width="1.6" Height="6" CornerRadius="0.8" Background="#37C058" Margin="0,0,1.5,0" VerticalAlignment="Center"/>

        <!-- 7 Orange Bars (#FB8B28) -->
        <Border x:Name="Bar7" Width="1.6" Height="7" CornerRadius="0.8" Background="#FB8B28" Margin="0,0,1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar8" Width="1.6" Height="12" CornerRadius="0.8" Background="#FB8B28" Margin="0,0,1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar9" Width="1.6" Height="10" CornerRadius="0.8" Background="#FB8B28" Margin="0,0,1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar10" Width="1.6" Height="14" CornerRadius="0.8" Background="#FB8B28" Margin="0,0,1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar11" Width="1.6" Height="11" CornerRadius="0.8" Background="#FB8B28" Margin="0,0,1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar12" Width="1.6" Height="9" CornerRadius="0.8" Background="#FB8B28" Margin="0,0,1,0" VerticalAlignment="Center"/>
        <Border x:Name="Bar13" Width="1.6" Height="5" CornerRadius="0.8" Background="#FB8B28" Margin="0" VerticalAlignment="Center"/>
    </StackPanel>
</UserControl>
