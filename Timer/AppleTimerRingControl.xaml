<UserControl x:Class="DynamicIsland.Timer.AppleTimerRingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="20"
             RenderOptions.BitmapScalingMode="HighQuality"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Outer Track Ring -->
        <Ellipse Width="18" Height="18" Stroke="#33FFFFFF" StrokeThickness="2.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Dynamic Orange Countdown Progress Arc -->
        <Path x:Name="TimerArcPath" Stroke="#FB8B28" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

        <!-- Center Inner Dark Cavity -->
        <Ellipse Width="12" Height="12" Fill="#181818" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Center Mini Apple SF Stopwatch / Clock Dial Icon -->
        <Path Data="M 10 4.5 C 7.5 4.5 5.5 6.5 5.5 9 C 5.5 11.5 7.5 13.5 10 13.5 C 12.5 13.5 14.5 11.5 14.5 9 C 14.5 6.5 12.5 4.5 10 4.5 Z M 10.4 6 L 10.4 9.2 L 12.2 10.3 L 11.7 11.1 L 9.5 9.8 L 9.5 6 Z"
              Fill="#FB8B28" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
