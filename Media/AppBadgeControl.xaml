<UserControl x:Class="DynamicIsland.Media.AppBadgeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"
             RenderOptions.BitmapScalingMode="HighQuality"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True">
    
    <Grid Width="22" Height="22">
        <!-- Pure White Squircle Badge (Matching Reference Screenshot 1:1) -->
        <Border Width="22" Height="22" CornerRadius="6" Background="#FFFFFF" BorderBrush="#25000000" BorderThickness="0.6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Direction="270" Opacity="0.35" Color="#000000"/>
            </Border.Effect>
            
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Colorful Brand Image (Chrome / Spotify / Apple Music / Edge / YouTube) -->
                <Image x:Name="ImgBadge" Width="15" Height="15" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Vector Fallback if image not found -->
                <Path x:Name="VectorBadge" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
