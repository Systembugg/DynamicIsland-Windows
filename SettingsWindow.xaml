<Window x:Class="DynamicIsland.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dynamic Island Settings" 
        Height="540" Width="440"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <!-- Window Glass Container -->
    <Border Background="#141416" CornerRadius="18" BorderBrush="#30FFFFFF" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="6" Direction="270" Opacity="0.6" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="22,18,22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8" Background="#0A84FF" Margin="0,0,10,0">
                        <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dynamic Island Settings" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Preferences, Startup &amp; Performance" Foreground="#88FFFFFF" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Border Width="26" Height="26" CornerRadius="13" Background="#20FFFFFF" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" MouseLeftButtonDown="BtnClose_MouseLeftButtonDown">
                    <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- SETTINGS CONTENT SCROLLER -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>

                    <!-- SECTION 1: GENERAL -->
                    <TextBlock Text="GENERAL" Foreground="#66FFFFFF" FontSize="10.5" FontWeight="Bold" Margin="4,0,0,8"/>
                    
                    <Border Background="#1C1C1E" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="0.8" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Auto-start with Windows -->
                            <Grid Margin="0,4,0,8">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Launch on Startup" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Start Dynamic Island automatically when Windows boots" Foreground="#77FFFFFF" FontSize="10"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkAutoStart" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ChkAutoStart_Changed" Unchecked="ChkAutoStart_Changed"/>
                            </Grid>

                            <Border Height="0.6" Background="#15FFFFFF" Margin="0,4"/>

                            <!-- Mode Selector (Notch vs Island) -->
                            <Grid Margin="0,6,0,6">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Display Mode" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Switch between Top Notch (macOS) and Floating Island" Foreground="#77FFFFFF" FontSize="10"/>
                                </StackPanel>
                                <ComboBox x:Name="CmbDisplayMode" Width="130" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="CmbDisplayMode_SelectionChanged">
                                    <ComboBoxItem Content="Top Notch (macOS)"/>
                                    <ComboBoxItem Content="Floating Island"/>
                                </ComboBox>
                            </Grid>

                            <Border Height="0.6" Background="#15FFFFFF" Margin="0,4"/>

                            <!-- Idle Mascot Face -->
                            <Grid Margin="0,6,0,4">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Idle Mascot Face (• . •)" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Show cute animated blinking face when idle" Foreground="#77FFFFFF" FontSize="10"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkIdleFace" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="ChkIdleFace_Changed" Unchecked="ChkIdleFace_Changed"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 2: SYSTEM HUDs -->
                    <TextBlock Text="SYSTEM OVERLAYS &amp; HUDs" Foreground="#66FFFFFF" FontSize="10.5" FontWeight="Bold" Margin="4,0,0,8"/>
                    
                    <Border Background="#1C1C1E" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="0.8" Padding="14,10" Margin="0,0,0,14">
                        <StackPanel>
                            <!-- Volume HUD -->
                            <Grid Margin="0,4,0,6">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Volume HUD" Foreground="#FFFFFF" FontSize="12" FontWeight="Medium"/>
                                    <TextBlock Text="Show smooth audio pill on volume change &amp; mouse scroll" Foreground="#77FFFFFF" FontSize="9.5"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkVolumeHud" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="0.6" Background="#15FFFFFF" Margin="0,3"/>

                            <!-- Brightness HUD -->
                            <Grid Margin="0,4,0,6">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Brightness HUD" Foreground="#FFFFFF" FontSize="12" FontWeight="Medium"/>
                                    <TextBlock Text="Show adaptive sun brightness gauge" Foreground="#77FFFFFF" FontSize="9.5"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkBrightnessHud" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Border Height="0.6" Background="#15FFFFFF" Margin="0,3"/>

                            <!-- Bluetooth HUD -->
                            <Grid Margin="0,4,0,4">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Bluetooth Connection HUD" Foreground="#FFFFFF" FontSize="12" FontWeight="Medium"/>
                                    <TextBlock Text="Popup on headphone / AirPods connection" Foreground="#77FFFFFF" FontSize="9.5"/>
                                </StackPanel>
                                <CheckBox x:Name="ChkBluetoothHud" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SECTION 3: MEMORY & PERFORMANCE -->
                    <TextBlock Text="SYSTEM RESOURCES &amp; MEMORY" Foreground="#66FFFFFF" FontSize="10.5" FontWeight="Bold" Margin="4,0,0,8"/>
                    
                    <Border Background="#1C1C1E" CornerRadius="12" BorderBrush="#1FFFFFFF" BorderThickness="0.8" Padding="14,12" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="RAM Working Set: " Foreground="#88FFFFFF" FontSize="11.5"/>
                                    <TextBlock x:Name="TxtRamUsage" Text="24 MB" Foreground="#30D158" FontSize="11.5" FontWeight="Bold"/>
                                </StackPanel>
                                <TextBlock Text="Ultra-lightweight OLED direct WPF rendering engine" Foreground="#66FFFFFF" FontSize="9.5" Margin="0,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" CornerRadius="8" Background="#280A84FF" Padding="10,5" Cursor="Hand" VerticalAlignment="Center" MouseLeftButtonDown="BtnOptimizeRam_MouseLeftButtonDown">
                                <TextBlock Text="🧹 Optimize RAM" Foreground="#0A84FF" FontSize="10.5" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="Tip: Press F11 anytime to toggle Notch / Island mode" Foreground="#66FFFFFF" FontSize="10" VerticalAlignment="Center"/>
                <Border CornerRadius="8" Background="#25FFFFFF" Padding="14,6" Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" MouseLeftButtonDown="BtnClose_MouseLeftButtonDown">
                    <TextBlock Text="Done" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>

        </Grid>
    </Border>
</Window>
