    <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
        <!-- The Notch / Island Shape Canvas -->
        <Grid x:Name="ShapeRoot"
              Width="162" Height="32"
              HorizontalAlignment="Center" 
              VerticalAlignment="Top"
              AllowDrop="True"
              DragEnter="ShapeRoot_DragEnter"
              DragLeave="ShapeRoot_DragLeave"
              Drop="ShapeRoot_Drop"
              MouseLeftButtonDown="ShapeRoot_MouseLeftButtonDown"
              MouseWheel="ShapeRoot_MouseWheel">

            <!-- Pitch-Black OLED Vector Shape with 0.5px Subpixel Glass Stroke -->
            <Path x:Name="NotchPath"
                  Fill="#000000"
                  Stroke="#22FFFFFF"
                  StrokeThickness="0.6"
                  StrokeLineJoin="Round"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"/>

            <!-- 1. STEALTH / PRIVACY, COMPACT MUSIC, TIMER & DOCK VIEW (Idle / Hover Glancing) -->
            <Grid x:Name="StealthView" Margin="16,0,16,0" VerticalAlignment="Center" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT WING: Primary Active Icon (Idle Face / Box / Album Art / Timer Ring / Privacy) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Idle Blinking Face Mascot (Apple FaceID Style with Green #37C058) -->
                    <Grid x:Name="IdleFaceContainer" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Visible">
                        <Viewbox Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Canvas Width="9.5" Height="9.0" ClipToBounds="False">
                                <Canvas.RenderTransform>
                                    <TranslateTransform X="-14.2" Y="-15.2"/>
                                </Canvas.RenderTransform>
                                <!-- Left Eye -->
                                <Path x:Name="MascotEyeLeft" Data="M15.2793 18.3047C14.8203 18.3047 14.498 17.9824 14.498 17.5137V16.1855C14.498 15.7168 14.8203 15.3945 15.2793 15.3945C15.7383 15.3945 16.0703 15.7168 16.0703 16.1855V17.5137C16.0703 17.9824 15.7383 18.3047 15.2793 18.3047Z" Fill="#37C058">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="ScaleEyeLeft" ScaleY="1.0" CenterX="15.28" CenterY="16.85"/>
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Right Eye -->
                                <Path x:Name="MascotEyeRight" Data="M22.6914 18.3047C22.2227 18.3047 21.9004 17.9824 21.9004 17.5137V16.1855C21.9004 15.7168 22.2227 15.3945 22.6914 15.3945C23.1406 15.3945 23.4629 15.7168 23.4629 16.1855V17.5137C23.4629 17.9824 23.1406 18.3047 22.6914 18.3047Z" Fill="#37C058">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="ScaleEyeRight" ScaleY="1.0" CenterX="22.68" CenterY="16.85"/>
                                    </Path.RenderTransform>
                                </Path>

                                <!-- Nose -->
                                <Path x:Name="MascotNose" Data="M18.2188 20.6094C17.7207 20.6094 17.4375 20.3652 17.4375 19.9453C17.4375 19.5938 17.7109 19.3203 18.0625 19.3203H18.4043C18.4922 19.3203 18.5508 19.2715 18.5508 19.1738V16.0098C18.5508 15.6289 18.8047 15.3848 19.1953 15.3848C19.5664 15.3848 19.8203 15.6289 19.8203 16.0098V19.0859C19.8203 20.0723 19.2832 20.6094 18.2969 20.6094H18.2188Z" Fill="#37C058"/>

                                <!-- Smile (Mouth) -->
                                <Path x:Name="MascotSmile" Data="M18.9414 23.8906C17.7598 23.8906 16.5195 23.4219 15.7285 22.5234C15.6016 22.3867 15.543 22.2305 15.543 22.0645C15.543 21.6934 15.8164 21.4297 16.1777 21.4297C16.4121 21.4297 16.5391 21.5469 16.6953 21.6934C17.2617 22.2695 18.1211 22.6309 18.9414 22.6309C19.8105 22.6309 20.6602 22.25 21.1973 21.6934C21.3828 21.498 21.5195 21.4297 21.7051 21.4297C22.0664 21.4297 22.3398 21.6934 22.3398 22.0645C22.3398 22.2598 22.2812 22.4258 22.1641 22.5332C21.3145 23.3828 20.123 23.8906 18.9414 23.8906Z" Fill="#37C058"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>

                    <!-- Dock Blue Open Box Icon (#0A84FF) -->
                    <Grid x:Name="DockCompactContainer" Width="20" Height="20" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="DockCompact_MouseLeftButtonDown" Visibility="Collapsed" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconDockBox}" Fill="Transparent" Stroke="#0A84FF" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Apple SF Timer Dial Ring Control -->
                    <localTimer:AppleTimerRingControl x:Name="TimerCompactRing" Width="20" Height="20" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="TimerCompact_MouseLeftButtonDown" Visibility="Collapsed" VerticalAlignment="Center"/>

                    <!-- Compact Album Art Thumbnail -->
                    <Border x:Name="CompactAlbumArtBorder" Width="18" Height="18" CornerRadius="4.5" ClipToBounds="True" Margin="0,0,6,0" Background="#181818" BorderBrush="#20FFFFFF" BorderThickness="0.5" Cursor="Hand" MouseLeftButtonDown="CompactAlbumArt_MouseLeftButtonDown" Visibility="Collapsed">
                        <Image x:Name="CompactAlbumArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <!-- Wireless Audio Compact Icon (TWS / Headphones - Left Wing) -->
                    <Grid x:Name="BluetoothCompactContainer" Width="20" Height="20" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="BluetoothCompact_MouseLeftButtonDown" Visibility="Collapsed" VerticalAlignment="Center">
                        <Path x:Name="IconCompactTws" Data="{StaticResource IconTwsEarbuds}" Stroke="#0A9CFF" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Path x:Name="IconCompactHeadphones" Data="{StaticResource IconHeadphones}" Fill="#0A9CFF" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Path x:Name="IconCompactBluetooth" Data="{StaticResource IconBluetooth}" Fill="#0A9CFF" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>

                    <!-- Network / Hotspot Compact Green Icon (Left Wing - Matching media_1787920389224.png 1:1) -->
                    <Grid x:Name="NetworkCompactContainer" Width="20" Height="20" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="NetworkCompact_MouseLeftButtonDown" Visibility="Collapsed" VerticalAlignment="Center">
                        <Path x:Name="IconNetworkCompactLink" Data="{StaticResource IconHotspotLink}" Stroke="#37C058" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="18" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- AirDrop Compact Cyan Icon (Left Wing) -->
                    <Grid x:Name="AirDropCompactContainer" Width="20" Height="20" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="AirDropCompact_MouseLeftButtonDown" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="AirDrop Transfer Active">
                        <Path Data="{StaticResource IconAirDropOfficial}" Fill="#37A3DE" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Screen Share Compact Blue Icon (Left Wing - Matching media_1787985144587.png 1:1) -->
                    <Grid x:Name="ScreenShareCompactLeftContainer" Width="20" Height="20" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="ScreenShareCompact_MouseLeftButtonDown" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Screen Sharing Active • Click to manage">
                        <Path Data="{StaticResource IconScreenShareLeft}" Fill="#37A3DE" Width="17" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    
                    <!-- Ongoing Voice Call (Left Wing - Green Phone + Live Duration) -->
                    <StackPanel x:Name="CallCompactVoiceLeftContainer" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="CallCompact_MouseLeftButtonDown" Visibility="Collapsed">
                        <Path Data="{StaticResource IconCallPhoneGreen}" Fill="#37C058" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="TxtCallCompactDuration" Text="00:00" Foreground="#37C058" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Ongoing Video Call (Left Wing - Green Video Camera) -->
                    <Grid x:Name="CallCompactVideoLeftContainer" Width="22" Height="20" Margin="0,0,6,0" Cursor="Hand" MouseLeftButtonDown="CallCompact_MouseLeftButtonDown" Visibility="Collapsed" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconCallVideoGreen}" Fill="#37C058" Width="19" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Privacy Indicator Dot (Left Wing - Shown during Active Music / Timer / Dock / Network) -->
                    <Grid x:Name="PrivacyDotLeftContainer" Visibility="Collapsed" Width="18" Height="18" Margin="0,0,4,0" VerticalAlignment="Center">
                        <Ellipse x:Name="PrivacyDotLeftGlow" Width="15" Height="15" Fill="#44FF3B30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse x:Name="PrivacyDotLeft" Width="9" Height="9" Fill="#FF3B30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid x:Name="DndStealthIndicator" Visibility="Collapsed" Width="14" Height="14">
                        <Path Data="{StaticResource IconMoon}" Fill="#5E5CE6" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- CENTER: Stealth Black Space -->
                <Grid Grid.Column="1"/>

                <!-- RIGHT WING: Dynamic Indicators (Clean Single-Activity by default, Multi on Hover) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Ongoing Call Waveform (Right Wing - 14 Dual-Tone Bars) -->
                    <localCall:CallWaveformControl x:Name="CallCompactWaveform" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="CallCompact_MouseLeftButtonDown" Visibility="Collapsed"/>

                    <!-- Screen Share Compact Gray Screen / Display Icon (Right Wing - Matching media_1787985144587.png 1:1) -->
                    <Grid x:Name="ScreenShareCompactRightContainer" Width="20" Height="20" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="ScreenShareCompact_MouseLeftButtonDown" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="Screen Sharing Active • Click to manage">
                        <Path Data="{StaticResource IconScreenShareRightTarget}" Fill="#8F8F8F" Width="18" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- AirDrop Compact Circular Progress Arc, Checkmark & Red Failed Cross (Right Wing) -->
                    <Grid x:Name="AirDropCompactProgressContainer" Width="22" Height="22" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="AirDropCompact_MouseLeftButtonDown" Visibility="Collapsed" VerticalAlignment="Center" ToolTip="AirDrop Progress">
                        <Ellipse Width="20" Height="20" Stroke="#2537A3DE" StrokeThickness="2.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="AirDropCompactArc" Stroke="#37A3DE" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="AirDropCompactCheckmark" Data="{StaticResource IconCheckmark}" Fill="#00E46C" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        <Path x:Name="AirDropCompactFailedCross" Data="{StaticResource IconXMark}" Fill="#FF3B30" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>

                    <!-- Dock Status Ring Gauge -->
                    <localDock:DockStatusRingControl x:Name="DockCompactRing" Width="20" Height="20" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="DockCompact_MouseLeftButtonDown" Visibility="Collapsed" VerticalAlignment="Center"/>

                    <!-- Compact 4-Bar Audio Visualizer -->
                    <localMedia:AudioVisualizerControl x:Name="CompactVisualizer" BarCount="4" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="CompactAlbumArt_MouseLeftButtonDown" Visibility="Collapsed"/>

                    <!-- Compact Timer Countdown Text -->
                    <TextBlock x:Name="TxtTimerCompact" Text="05:00" Foreground="#FB8B28" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="TimerCompact_MouseLeftButtonDown" Visibility="Collapsed"/>

                    <!-- Bluetooth Compact Battery Text -->
                    <TextBlock x:Name="TxtBluetoothCompact" Text="100%" Foreground="#0A9CFF" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="BluetoothCompact_MouseLeftButtonDown" Visibility="Collapsed"/>

                    <!-- Network Compact Speed Text (Right Wing) -->
                    <TextBlock x:Name="TxtNetworkCompact" Text="0.0 KB/s" Foreground="#37C058" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Hand" MouseLeftButtonDown="NetworkCompact_MouseLeftButtonDown" Visibility="Collapsed"/>

                    <!-- Privacy Indicator Dot (Right Wing - Shown during Idle / Mascot Mode) -->
                    <Grid x:Name="PrivacyDotRightContainer" Visibility="Collapsed" Width="18" Height="18" Margin="2,0,0,0" VerticalAlignment="Center">
                        <Ellipse x:Name="PrivacyDotRightGlow" Width="15" Height="15" Fill="#44FF3B30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse x:Name="PrivacyDotRight" Width="9" Height="9" Fill="#FF3B30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 2. UNIVERSAL APPLE EXPANDED CARD (Direct Top Navigation Switcher, Generous Spacing) -->
            <Grid x:Name="UniversalExpandedContainer" Margin="22,12,22,12" VerticalAlignment="Stretch" Background="#01000000" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ROW 0: TOP APP SWITCHER NAVIGATION BAR -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <!-- Left: Navigation Icons Pills -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Home Icon -->
                        <Border x:Name="BtnNavHome" Width="30" Height="30" CornerRadius="15" Background="#191A1D" Margin="0,0,5,0" Cursor="Hand" ToolTip="Home" MouseLeftButtonDown="BtnNavHome_MouseLeftButtonDown">
                            <Path x:Name="IconNavHome" Data="{StaticResource IconHome}" Stroke="#E9E9ED" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- File Drop / Shelf Icon -->
                        <Border x:Name="BtnNavShelf" Width="30" Height="30" CornerRadius="15" Background="#191A1D" Margin="0,0,5,0" Cursor="Hand" ToolTip="Dock Shelf" MouseLeftButtonDown="BtnNavShelf_MouseLeftButtonDown">
                            <Path x:Name="IconNavShelf" Data="{StaticResource IconDockBox}" Stroke="#E9E9ED" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Music / Media Player Icon -->
                        <Border x:Name="BtnNavMusic" Width="30" Height="30" CornerRadius="15" Background="#191A1D" Margin="0,0,5,0" Cursor="Hand" ToolTip="Now Playing" MouseLeftButtonDown="BtnNavMusic_MouseLeftButtonDown">
                            <Path x:Name="IconNavMusic" Data="{StaticResource IconMusicNote}" Stroke="#E9E9ED" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Timer Icon (Direct Timer Switching) -->
                        <Border x:Name="BtnNavTimer" Width="30" Height="30" CornerRadius="15" Background="#191A1D" Margin="0,0,5,0" Cursor="Hand" ToolTip="Timer / Stopwatch" MouseLeftButtonDown="BtnNavTimer_MouseLeftButtonDown">
                            <Path x:Name="IconNavTimer" Data="{StaticResource IconStopwatch}" Fill="Transparent" Stroke="#E9E9ED" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Bluetooth Devices Icon (Direct Bluetooth Switching) -->
                        <Border x:Name="BtnNavBluetooth" Width="30" Height="30" CornerRadius="15" Background="#191A1D" Margin="0,0,5,0" Cursor="Hand" ToolTip="Bluetooth &amp; Connected Devices" MouseLeftButtonDown="BtnNavBluetooth_MouseLeftButtonDown">
                            <Path x:Name="IconNavBluetooth" Data="{StaticResource IconBluetooth}" Fill="#E9E9ED" StrokeThickness="0" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Clipboard, Notes & Snippets Icon (Matching media_1788009844664.png) -->
                        <Border x:Name="BtnNavClipboard" Width="30" Height="30" CornerRadius="15" Background="#191A1D" Margin="0,0,5,0" Cursor="Hand" ToolTip="Notes, Clipboard &amp; Snippets" MouseLeftButtonDown="BtnNavClipboard_MouseLeftButtonDown">
                            <Path x:Name="IconNavClipboard" Data="{StaticResource IconClipboard}" Fill="#E9E9ED" StrokeThickness="0" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Network Speed Link Icon (Direct Network Speed Switching) -->
                        <Border x:Name="BtnNavNetwork" Width="30" Height="30" CornerRadius="15" Background="#191A1D" Margin="0,0,5,0" Cursor="Hand" ToolTip="Real-time Network Speed" MouseLeftButtonDown="BtnNavNetwork_MouseLeftButtonDown">
                            <Path x:Name="IconNavNetwork" Data="{StaticResource IconHotspotLink}" Stroke="#E9E9ED" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="15" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Screen Mirroring Icon (Direct Screen Share Switching) -->
                        <Border x:Name="BtnNavScreenMirroring" Width="30" Height="30" CornerRadius="15" Background="#191A1D" Cursor="Hand" ToolTip="Screen Mirroring" MouseLeftButtonDown="BtnNavScreenMirroring_MouseLeftButtonDown">
                            <Path x:Name="IconNavScreenMirroring" Data="{StaticResource IconScreenShareLeft}" Fill="#E9E9ED" StrokeThickness="0" Width="14" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Right: Clear & Pin Toggle Controls (Clean Apple circular icons matching media_1788009844664.png) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <!-- Clear All Shelf Items Button -->
                        <Border x:Name="BtnClearAllShelf" Width="28" Height="28" CornerRadius="14" Background="#191A1D" Margin="0,0,6,0" Cursor="Hand" ToolTip="Clear All Docked Items" MouseLeftButtonDown="BtnClearShelf_MouseLeftButtonDown">
                            <Path Data="{StaticResource IconTrash}" Fill="#A0A0A8" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Pin Shelf Toggle -->
                        <Border x:Name="BtnPinShelf" Width="28" Height="28" CornerRadius="14" Background="#191A1D" Cursor="Hand" ToolTip="Pin (Keep Open)" MouseLeftButtonDown="BtnPinShelf_MouseLeftButtonDown">
                            <Path x:Name="IconPinShape" Data="{StaticResource IconPin}" Fill="#EDEDF0" Width="11" Height="11" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ROW 1: DYNAMIC BODY CONTENT (Swapped directly between Shelf, Music, Timer) -->
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <!-- A. FULL-WIDTH SPACIOUS DROPZONE & FILE SHELF VIEW (Split AirDrop + Dock Box) -->
                    <Grid x:Name="ViewShelfBody" Visibility="Visible">
                        <Grid.ColumnDefinitions>
                            <!-- Left: Dedicated AirDrop Send Dropzone (~25%) -->
                            <ColumnDefinition Width="110"/>
                            <!-- Right: Dock Files Storage Dropzone (~75%) -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: AirDrop Send Drop Tile (Matching media_1787922322710.png) -->
                        <Border x:Name="AirDropDropTile" Grid.Column="0" Margin="0,0,10,0" CornerRadius="18" Background="#0C1B26" BorderThickness="0" Cursor="Hand"
                                AllowDrop="True"
                                DragOver="AirDropDropTile_DragOver"
                                DragLeave="AirDropDropTile_DragLeave"
                                Drop="AirDropDropTile_Drop"
                                MouseLeftButtonDown="AirDropDropTile_MouseLeftButtonDown">
                            <Grid>
                                <!-- Dashed Cyan Hover Ring -->
                                <Rectangle x:Name="AirDropTileDashed" RadiusX="18" RadiusY="18" Stroke="#37A3DE" StrokeThickness="1.2" StrokeDashArray="3 3" IsHitTestVisible="False"/>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path Data="{StaticResource IconAirDropOfficial}" Fill="#37A3DE" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <TextBlock Text="AirDrop" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Send to phone" Foreground="#6CA8D1" FontSize="9.5" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Right: Dock / Shelf Storage Dropzone (75% Width) -->
                        <Border x:Name="ShelfDropZoneBorder" Grid.Column="1" CornerRadius="18" Background="#101114" BorderThickness="0" Cursor="Hand"
                                AllowDrop="True"
                                DragOver="ShelfDropZone_DragOver"
                                DragLeave="ShelfDropZone_DragLeave"
                                Drop="ShelfDropZone_Drop"
                                MouseLeftButtonDown="ShelfDropZoneBorder_MouseLeftButtonDown"
                                PreviewMouseWheel="ShelfFilesScrollViewer_PreviewMouseWheel">
                            <Grid>
                                <!-- Dashed Border Overlay -->
                                <Rectangle x:Name="ShelfDropZoneDashed" RadiusX="18" RadiusY="18" Stroke="#B80A84FF" StrokeThickness="1.2" StrokeDashArray="4 4" IsHitTestVisible="False"/>
                                
                                <Grid Margin="10,8">
                                    <!-- Empty State Prompt -->
                                    <StackPanel x:Name="ShelfEmptyPrompt" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                                        <Path Data="{StaticResource IconDropCube}" Stroke="#0A84FF" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="Drop files to pin here" Foreground="#EDEDF0" FontSize="12.5" FontWeight="Medium" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Drag out anytime to use in apps" Foreground="#7E7F86" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Docked Files Horizontal List (Hidden scrollbar with smooth mouse wheel scroll) -->
                                    <ScrollViewer x:Name="ShelfFilesScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False" Visibility="Collapsed" PreviewMouseWheel="ShelfFilesScrollViewer_PreviewMouseWheel">
                                        <ItemsControl x:Name="DockItemsList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="88" Height="68" Margin="0,0,8,0" CornerRadius="12" Background="#111214" BorderBrush="#28FFFFFF" BorderThickness="1" Cursor="Hand"
                                                            MouseLeftButtonDown="DockItemCard_MouseLeftButtonDown"
                                                            MouseMove="DockItemCard_MouseMove"
                                                            ToolTip="{Binding FilePath}">
                                                        <Grid>
                                                            <Grid Margin="6,4">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="30"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Image Grid.Row="0" Source="{Binding Thumbnail}" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Row="1" Text="{Binding FileName}" Foreground="#E8E8EC" FontSize="9" FontWeight="Medium" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                                <TextBlock Grid.Row="2" Text="{Binding FileSizeFormatted}" Foreground="#6F7077" FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                                            </Grid>
                                                            <!-- Individual Delete Option (Apple Style [✕] badge) -->
                                                            <Border Width="18" Height="18" CornerRadius="9" Background="#4D000000" BorderBrush="#33FFFFFF" BorderThickness="0.6" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="3" Cursor="Hand" ToolTip="Remove from Dock" PreviewMouseLeftButtonDown="BtnRemoveDockItem_Click">
                                                                <Path Data="{StaticResource IconXMark}" Fill="#E8E8EC" Width="7.5" Height="7.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- B. FULL RICH MUSIC PLAYER + APPLE MUSIC LIVE KARAOKE VIEW -->
                    <Grid x:Name="ViewMusicBody" Visibility="Collapsed" Margin="0,4,0,0" VerticalAlignment="Top">
                        
                        <!-- 1. STANDARD ALBUM ART & MEDIA CONTROLS VIEW (Normal Wala Zinda Baad!) -->
                        <Grid x:Name="MusicStandardPlayerView" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Square Album Art + White Squircle Brand Badge (Chrome/Spotify) -->
                            <Grid Grid.Column="0" Width="76" Height="76" VerticalAlignment="Top" Margin="0,0,18,0">
                                <!-- Album Art with 16px Rounded Corners -->
                                <Border Width="76" Height="76" CornerRadius="16" ClipToBounds="True" Background="#1A1A1A" BorderBrush="#20FFFFFF" BorderThickness="0.6">
                                    <Grid>
                                        <Path Data="{StaticResource IconMusicNote}" Fill="#33FFFFFF" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Image x:Name="ExpandedAlbumArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                
                                <!-- White Squircle Brand Badge (Positioned at bottom-right corner) -->
                                <localMedia:AppBadgeControl x:Name="AppSourceBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4"/>
                            </Grid>

                            <!-- Title + Scrubber + Centered Media Controls -->
                            <Grid Grid.Column="1" VerticalAlignment="Top">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Track Title & Clean Artist Name + Apple Music Lyrics Button -->
                                <Grid Grid.Row="0" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtMusicTitle" Text="Track Title" Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtMusicArtist" Text="Artist Name" Foreground="#99FFFFFF" FontSize="12" FontWeight="Normal" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Apple Music Style Live Lyrics Toggle Button [ 💬 ] -->
                                    <Border x:Name="BtnToggleLyricsFromPlayer" Grid.Column="1" Width="30" Height="30" CornerRadius="15" Background="#1CFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Cursor="Hand" ToolTip="Open Live Synchronized Lyrics / Karaoke" MouseLeftButtonDown="BtnToggleLyrics_MouseLeftButtonDown" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconAppleLyrics}" Fill="#FFFFFF" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <!-- Row 1: Apple Progress Scrubber & Sub-Timestamps -->
                                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                                    <Grid Height="14" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="MusicScrubber_MouseLeftButtonDown">
                                        <Border x:Name="MusicScrubberTrackBorder" Height="3.5" Background="#28FFFFFF" CornerRadius="1.75" ClipToBounds="True">
                                            <Grid HorizontalAlignment="Left">
                                                <Border x:Name="MusicProgressFill" Width="0" Height="3.5" Background="#FFFFFF" CornerRadius="1.75"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,1.5,0,0">
                                        <TextBlock x:Name="TxtTimeElapsed" Text="0:00" Foreground="#88FFFFFF" FontSize="9.5" FontWeight="Medium" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="TxtTimeRemaining" Text="0:00" Foreground="#88FFFFFF" FontSize="9.5" FontWeight="Medium" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Row 2: Media Transport Controls (⏮ Prev | ▶/⏸ Play/Pause | ⏭ Next | ↺ Replay) -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0">
                                    <Border Width="28" Height="28" Background="Transparent" CornerRadius="14" Cursor="Hand" ToolTip="Previous Track" MouseLeftButtonDown="BtnPrev_MouseLeftButtonDown">
                                        <Path Data="{StaticResource IconMediaPrev}" Fill="#FFFFFF" Width="13.5" Height="13.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="34" Height="34" Background="Transparent" CornerRadius="17" Cursor="Hand" Margin="18,0" MouseLeftButtonDown="BtnPlayPause_MouseLeftButtonDown">
                                        <Path x:Name="IconPlayPauseShape" Data="{StaticResource IconMediaPlay}" Fill="#FFFFFF" Width="15.5" Height="15.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="28" Height="28" Background="Transparent" CornerRadius="14" Cursor="Hand" ToolTip="Next Track" MouseLeftButtonDown="BtnNext_MouseLeftButtonDown">
                                        <Path Data="{StaticResource IconMediaNext}" Fill="#FFFFFF" Width="13.5" Height="13.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="28" Height="28" Background="Transparent" CornerRadius="14" Cursor="Hand" Margin="14,0,0,0" ToolTip="Replay Track from start" MouseLeftButtonDown="BtnReplay_MouseLeftButtonDown">
                                        <Path Data="{StaticResource IconMediaReplay}" Fill="#AAFFFFFF" Width="13.5" Height="13.5" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 2. APPLE MUSIC SPLIT 2-COLUMN DESKTOP LIVE LYRICS (media_1788013340222.png 1:1) -->
                        <Grid x:Name="MusicLyricsKaraokeView" Visibility="Collapsed" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="205"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: Album Art + Song Title/Artist + Scrubber + Full Controls + Switch to Normal -->
                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Row 0: Large Square Album Art + Badges -->
                                <Grid Grid.Row="0" Width="88" Height="88" HorizontalAlignment="Left" Margin="0,0,0,10">
                                    <Border Width="88" Height="88" CornerRadius="16" ClipToBounds="True" Background="#1A1A1A" BorderBrush="#25FFFFFF" BorderThickness="0.8">
                                        <Grid>
                                            <Path Data="{StaticResource IconMusicNote}" Fill="#33FFFFFF" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image x:Name="LyricsMiniAlbumArt" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <localMedia:AppBadgeControl x:Name="LyricsAppSourceBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-4"/>
                                </Grid>

                                <!-- Row 1: Title & Artist -->
                                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                    <TextBlock x:Name="TxtLyricsSongTitle" Text="Song Title" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TxtLyricsArtist" Text="Artist Name" Foreground="#99FFFFFF" FontSize="11.5" FontWeight="Normal" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Row 2: Apple Progress Scrubber & Sub-Timestamps -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                    <Grid Height="14" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonDown="MusicScrubber_MouseLeftButtonDown">
                                        <Border x:Name="LyricsScrubberTrackBorder" Height="3.5" Background="#28FFFFFF" CornerRadius="1.75" ClipToBounds="True">
                                            <Grid HorizontalAlignment="Left">
                                                <Border x:Name="LyricsMiniProgressFill" Width="0" Height="3.5" Background="#FF2455" CornerRadius="1.75"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,1.5,0,0">
                                        <TextBlock x:Name="TxtLyricsTimeElapsed" Text="0:00" Foreground="#88FFFFFF" FontSize="9" FontWeight="Medium" HorizontalAlignment="Left"/>
                                        <TextBlock x:Name="TxtLyricsTimeRemaining" Text="0:00" Foreground="#88FFFFFF" FontSize="9" FontWeight="Medium" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>

                                <!-- Row 3: Full Media Controls + Return to Player Button -->
                                <Grid Grid.Row="3">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border Width="26" Height="26" Background="Transparent" CornerRadius="13" Cursor="Hand" ToolTip="Previous Track" MouseLeftButtonDown="BtnPrev_MouseLeftButtonDown">
                                            <Path Data="{StaticResource IconMediaPrev}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="30" Height="30" Background="Transparent" CornerRadius="15" Cursor="Hand" Margin="8,0" MouseLeftButtonDown="BtnPlayPause_MouseLeftButtonDown">
                                            <Path x:Name="IconLyricsPlayPauseShape" Data="{StaticResource IconMediaPlay}" Fill="#FFFFFF" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Border Width="26" Height="26" Background="Transparent" CornerRadius="13" Cursor="Hand" ToolTip="Next Track" MouseLeftButtonDown="BtnNext_MouseLeftButtonDown">
                                            <Path Data="{StaticResource IconMediaNext}" Fill="#FFFFFF" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Return to Standard Player Button -->
                                        <Border x:Name="BtnTogglePlayerFromLyrics" Margin="10,0,0,0" Height="26" CornerRadius="13" Background="#1FFFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1" Padding="8,0" Cursor="Hand" ToolTip="Return to standard player" MouseLeftButtonDown="BtnTogglePlayerFromLyrics_MouseLeftButtonDown" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource IconAppleMusicNote}" Fill="#FF2455" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                <TextBlock Text="Player" Foreground="#FFFFFF" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <!-- RIGHT COLUMN: Apple Music Live Karaoke Lyrics Scroll View (Matching media_1788013340222.png) -->
                            <Grid Grid.Column="2" VerticalAlignment="Stretch">
                                <ScrollViewer x:Name="LyricsScrollViewer" Height="205" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" PreviewMouseWheel="LyricsScrollViewer_PreviewMouseWheel">
                                    <Grid VerticalAlignment="Top">
                                        <!-- Loading State Prompt -->
                                        <StackPanel x:Name="LyricsLoadingPrompt" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,70,0,0" Visibility="Collapsed">
                                            <TextBlock Text="Fetching lyrics..." Foreground="#8E8E93" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Empty / Instrumental Prompt -->
                                        <StackPanel x:Name="LyricsEmptyPrompt" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,70,0,0" Visibility="Collapsed">
                                            <TextBlock Text="♪ Instrumental / No lyrics found ♪" Foreground="#6E6E73" FontSize="14" FontWeight="Medium" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Lyrics Lines StackPanel with spacious padding -->
                                        <StackPanel x:Name="LyricsLinesStackPanel" VerticalAlignment="Top" Margin="0,35,0,80"/>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- C. FULL APPLE TIMER VIEW (Exact Figma 1:1 Specs + Custom Duration Setup) -->
                    <Grid x:Name="ViewTimerBody" Visibility="Collapsed">
                        
                        <!-- State 1: ACTIVE RUNNING / PAUSED TIMER (Exact Figma Specs) -->
                        <Grid x:Name="TimerActiveContainer" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Leading Left: Circular Action Buttons (Pause/Play + Cancel) -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                <!-- Pause / Resume Button (Ellipse 27: #FB8B28 45% opacity) -->
                                <Border x:Name="BtnTimerPauseResume" Width="48" Height="48" CornerRadius="24" Background="#73FB8B28" Cursor="Hand" ToolTip="Pause / Resume Timer" MouseLeftButtonDown="BtnTimerPauseResume_MouseLeftButtonDown">
                                    <Path x:Name="IconTimerPauseResume" Data="{StaticResource IconMediaPause}" Fill="#FB8B28" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Cancel / Stop Button (Ellipse 28: #838388 70% opacity) -->
                                <Border x:Name="BtnTimerCancel" Width="48" Height="48" CornerRadius="24" Background="#B3838388" Cursor="Hand" Margin="12,0,0,0" ToolTip="Cancel / Stop Timer" MouseLeftButtonDown="BtnTimerCancel_MouseLeftButtonDown">
                                    <Path Data="{StaticResource IconXMark}" Fill="#FFFFFF" Width="15" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Trailing Right: Timer Label + Big 32px Orange Countdown -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock x:Name="TxtTimerLabel" Text="Timer" Foreground="#FB8B28" FontSize="16" FontWeight="Normal" VerticalAlignment="Bottom" Margin="0,0,10,5"/>
                                <TextBlock x:Name="TxtTimerExpanded" Text="3:35" Foreground="#FB8B28" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <!-- State 2: CUSTOM TIMER SETTER & PRESETS (When Inactive or Setting Custom Duration) -->
                        <Grid x:Name="TimerSetupContainer" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Custom Duration Stepper & Start Button -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Stepper Controls: [-] [ 5 min ] [+] -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#26FFFFFF" Cursor="Hand" ToolTip="Decrease 1 Minute" MouseLeftButtonDown="BtnTimerMinus_MouseLeftButtonDown">
                                        <TextBlock Text="−" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                                    </Border>
                                    <Border Background="#1AFFFFFF" CornerRadius="10" Padding="12,4" Margin="8,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="TxtCustomMinutes" Text="5" Foreground="#FB8B28" FontSize="16" FontWeight="Bold"/>
                                            <TextBlock Text=" min" Foreground="#CCFFFFFF" FontSize="13" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#26FFFFFF" Cursor="Hand" ToolTip="Increase 1 Minute" MouseLeftButtonDown="BtnTimerPlus_MouseLeftButtonDown">
                                        <TextBlock Text="+" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <!-- Start Timer Orange Pill Button -->
                                <Border Grid.Column="2" CornerRadius="15" Background="#FB8B28" Padding="16,6" Cursor="Hand" ToolTip="Start Timer" MouseLeftButtonDown="BtnTimerStartCustom_MouseLeftButtonDown">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IconMediaPlay}" Fill="#000000" Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="Start" Foreground="#000000" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Row 1: Quick Preset Pills (1m, 5m, 10m, 15m, 25m Pomodoro, 30m, 60m) -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border CornerRadius="11" Background="#18FB8B28" BorderBrush="#33FB8B28" BorderThickness="0.8" Padding="9,3.5" Margin="0,0,6,0" Cursor="Hand" ToolTip="1 Minute Quick Timer" MouseLeftButtonDown="BtnPreset_1m_Click">
                                    <TextBlock Text="1m" Foreground="#FB8B28" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border CornerRadius="11" Background="#18FB8B28" BorderBrush="#33FB8B28" BorderThickness="0.8" Padding="9,3.5" Margin="0,0,6,0" Cursor="Hand" ToolTip="5 Minutes Timer" MouseLeftButtonDown="BtnPreset_5m_Click">
                                    <TextBlock Text="5m" Foreground="#FB8B28" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border CornerRadius="11" Background="#18FB8B28" BorderBrush="#33FB8B28" BorderThickness="0.8" Padding="9,3.5" Margin="0,0,6,0" Cursor="Hand" ToolTip="10 Minutes Timer" MouseLeftButtonDown="BtnPreset_10m_Click">
                                    <TextBlock Text="10m" Foreground="#FB8B28" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border CornerRadius="11" Background="#18FB8B28" BorderBrush="#33FB8B28" BorderThickness="0.8" Padding="9,3.5" Margin="0,0,6,0" Cursor="Hand" ToolTip="15 Minutes Timer" MouseLeftButtonDown="BtnPreset_15m_Click">
                                    <TextBlock Text="15m" Foreground="#FB8B28" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border CornerRadius="11" Background="#18FB8B28" BorderBrush="#33FB8B28" BorderThickness="0.8" Padding="9,3.5" Margin="0,0,6,0" Cursor="Hand" ToolTip="25 Minutes Pomodoro Focus" MouseLeftButtonDown="BtnPreset_25m_Click">
                                    <TextBlock Text="25m" Foreground="#FB8B28" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border CornerRadius="11" Background="#18FB8B28" BorderBrush="#33FB8B28" BorderThickness="0.8" Padding="9,3.5" Margin="0,0,6,0" Cursor="Hand" ToolTip="30 Minutes Timer" MouseLeftButtonDown="BtnPreset_30m_Click">
                                    <TextBlock Text="30m" Foreground="#FB8B28" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Border CornerRadius="11" Background="#18FB8B28" BorderBrush="#33FB8B28" BorderThickness="0.8" Padding="9,3.5" Cursor="Hand" ToolTip="60 Minutes Timer" MouseLeftButtonDown="BtnPreset_60m_Click">
                                    <TextBlock Text="60m" Foreground="#FB8B28" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </Grid>

                    <!-- D. FULL APPLE BLUETOOTH & AUDIO OUTPUT SWITCHER VIEW -->
                    <Grid x:Name="ViewBluetoothBody" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Top Row: Active Device Info & Action Buttons -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Device Icon Tile (48px x 38px) -->
                            <Grid Grid.Column="0" Width="48" Height="38" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Image x:Name="ExpDeviceIconImage" Width="44" Height="32" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Path x:Name="ExpDeviceIconVector" Data="{StaticResource IconTwsEarbuds}" Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="32" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>

                            <!-- Center: Device Name & Live Status Subtitle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtExpBtDeviceName" Text="Internal Speakers" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="TxtExpBtSubtitle" Text="Connected" Foreground="#8E8E93" FontSize="12" FontWeight="Normal" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Right: Real Battery Gauge, Direct Disconnect & Settings Button -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Battery Level Indicator (40px Radial Gauge) -->
                                <Grid x:Name="ExpBatteryContainer" Width="40" Height="40" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Ellipse Width="38" Height="38" Stroke="#173B2A" StrokeThickness="3.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Path x:Name="ExpBtBatteryArc" Stroke="#00E46C" StrokeThickness="3.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Ellipse Width="30" Height="30" Fill="#000000" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtExpBtBatteryPercent" Text="58" Foreground="#00E46C" FontSize="13.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Direct Disconnect Button (Available when wireless device is connected) -->
                                <Border x:Name="BtnDisconnectBt" Width="32" Height="32" CornerRadius="16" Background="#25FF453A" Margin="0,0,8,0" Cursor="Hand" ToolTip="Disconnect / Switch to Speakers" MouseLeftButtonDown="BtnDisconnectCurrentBt_MouseLeftButtonDown" Visibility="Collapsed">
                                    <Path Data="{StaticResource IconXMark}" Fill="#FF453A" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Bluetooth Settings Link Button -->
                                <Border Width="32" Height="32" CornerRadius="16" Background="#20FFFFFF" Cursor="Hand" ToolTip="Open Windows Bluetooth Settings" MouseLeftButtonDown="BtnOpenBtSettings_MouseLeftButtonDown">
                                    <Path Data="{StaticResource IconBluetooth}" Fill="#0A84FF" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Interactive Audio Output Selector Bar (Click to Open Output Switcher) -->
                        <Border x:Name="BtnToggleOutputSelector" Grid.Row="1" Margin="0,10,0,0" Height="34" CornerRadius="12" Background="#16181D" BorderBrush="#25FFFFFF" BorderThickness="1" Padding="10,0" Cursor="Hand" ToolTip="Click to choose audio playback output" MouseLeftButtonDown="BtnToggleOutputSelector_MouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Icon: Speaker / Headphone -->
                                <Path x:Name="IconSelectedOutput" Grid.Column="0" Data="{StaticResource IconSpeakerMedium}" Fill="#0A84FF" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                <!-- Center: "Output: Device Name" -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Output: " Foreground="#8E8E93" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtSelectedOutputName" Text="Internal Speakers" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                                </StackPanel>

                                <!-- Right: Chevron indicator -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Switch" Foreground="#0A84FF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <Path x:Name="IconOutputChevron" Data="{StaticResource IconChevronDown}" Fill="#0A84FF" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Row 2: Expandable Audio Outputs Dropdown List -->
                        <Border x:Name="AudioOutputDropdownContainer" Grid.Row="2" Margin="0,8,0,0" Background="#111317" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="12" Padding="6" Visibility="Collapsed">
                            <StackPanel x:Name="AudioOutputDevicesList">
                                <!-- Populated dynamically with available audio output device rows -->
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- E. FULL REAL-TIME NETWORK SPEED VIEW (Matching Hotspot Reference) -->
                    <Grid x:Name="ViewNetworkBody" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Figma Native Personal Hotspot Tile (Matching media_1787920389224.png 1:1) -->
                        <Grid Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Border x:Name="BorderNetworkTile" Width="44" Height="44" CornerRadius="22" Background="#000000" BorderBrush="#3337C058" BorderThickness="1">
                                <Path x:Name="IconNetworkExpandedLink" Data="{StaticResource IconHotspotLink}" Stroke="#37C058" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="26" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Center: Network Adapter Name & Active Speed Counter -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtNetworkInterface" Text="Wi-Fi Network" Foreground="#FFFFFF" FontSize="14.5" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock x:Name="TxtNetworkDownloadArrow" Text="↓ " Foreground="#37C058" FontSize="13" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtNetworkExpandedSpeed" Text="0.0 KB/s" Foreground="#37C058" FontSize="13.5" FontWeight="SemiBold"/>
                                <TextBlock Text="   ↑ " Foreground="#0A9CFF" FontSize="13" FontWeight="Bold" Margin="6,0,0,0"/>
                                <TextBlock x:Name="TxtNetworkExpandedUpload" Text="0.0 KB/s" Foreground="#0A9CFF" FontSize="13.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Live Active Status Badge -->
                        <Border x:Name="BadgeNetworkStatus" Grid.Column="2" CornerRadius="10" Background="#1837C058" BorderBrush="#3337C058" BorderThickness="0.6" Padding="8,4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DotNetworkStatus" Width="6" Height="6" Fill="#37C058" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtNetworkStatus" Text="Online" Foreground="#37C058" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- F. AUTHENTIC APPLE SCREEN MIRRORING TAB VIEW (Matching media_1787986030265.png 1:1) -->
                    <Grid x:Name="ViewScreenMirroringBody" Visibility="Collapsed" Margin="0,4,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: Top Section (Left: Blue Screen Share Icon, Center: Title & Host, Right: Gray Laptop Icon) -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Blue Screen Mirroring Double Screens Icon -->
                            <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Path Data="{StaticResource IconScreenShareLeft}" Fill="#37A3DE" Width="26" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Center: Title & Subtitle -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Screen Mirroring" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtExpandedScreenMirroringTarget" Text="infinity" Foreground="#8E8E93" FontSize="13" FontWeight="Normal" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Right: Gray Laptop / Display Icon -->
                            <Grid Grid.Column="2" Width="28" Height="28" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconScreenShareRightTarget}" Fill="#8F8F8F" Width="22" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Row 1: Action Button (Stop Mirroring or Cast) -->
                        <Border x:Name="BtnExpandedStopMirroring" Grid.Row="1" Height="40" CornerRadius="20" Background="#1A1C2D" Cursor="Hand" ToolTip="Toggle Screen Mirroring / Stop Active Share" MouseLeftButtonDown="BtnExpandedStopMirroring_Click">
                            <TextBlock x:Name="TxtExpandedStopMirroringBtn" Text="Stop Mirroring" Foreground="#37A3DE" FontSize="14.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- G. UNIFIED NOTES, CLIPBOARD & SNIPPETS VIEW (Matching media_1788009864963.png 1:1) -->
                    <Grid x:Name="ViewClipboardBody" Visibility="Collapsed">
                        <!-- 1. List Mode View (Search, Tabs & Scrollable History) -->
                        <Grid x:Name="ViewClipboardListContent" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Top Segmented Pill Switcher Header (media_1788009864963.png) -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: New Note / Add Snippet Button -->
                                <Border x:Name="BtnNewNoteOrSnippet" Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#1C1C1E" Cursor="Hand" ToolTip="New Note / Snippet" MouseLeftButtonDown="BtnNewNoteOrSnippet_MouseLeftButtonDown">
                                    <Path Data="{StaticResource IconCompose}" Fill="#8E8E93" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Center: 4-Way Segmented Capsule Pill [ Notes | Clipboard | Screenshots | Snippets ] -->
                                <Border Grid.Column="1" HorizontalAlignment="Center" Height="32" CornerRadius="16" Background="#141416" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Segment 1: Notes -->
                                        <Border x:Name="BtnSubTabNotes" CornerRadius="13" Background="#2C2C2E" Padding="10,0" Cursor="Hand" MouseLeftButtonDown="BtnSubTabNotes_MouseLeftButtonDown">
                                            <TextBlock x:Name="TxtSubTabNotes" Text="Notes" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Segment 2: Clipboard -->
                                        <Border x:Name="BtnSubTabClipboard" CornerRadius="13" Background="Transparent" Padding="10,0" Cursor="Hand" MouseLeftButtonDown="BtnSubTabClipboard_MouseLeftButtonDown">
                                            <TextBlock x:Name="TxtSubTabClipboard" Text="Clipboard" Foreground="#8E8E93" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Segment 3: Screenshots -->
                                        <Border x:Name="BtnSubTabScreenshots" CornerRadius="13" Background="Transparent" Padding="10,0" Cursor="Hand" MouseLeftButtonDown="BtnSubTabScreenshots_MouseLeftButtonDown">
                                            <TextBlock x:Name="TxtSubTabScreenshots" Text="Screenshots" Foreground="#8E8E93" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Segment 4: Snippets -->
                                        <Border x:Name="BtnSubTabSnippets" CornerRadius="13" Background="Transparent" Padding="10,0" Cursor="Hand" MouseLeftButtonDown="BtnSubTabSnippets_MouseLeftButtonDown">
                                            <TextBlock x:Name="TxtSubTabSnippets" Text="Snippets" Foreground="#8E8E93" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Right: Clear / Settings Button -->
                                <Border x:Name="BtnClearClipboardHistory" Grid.Column="2" Width="30" Height="30" CornerRadius="15" Background="#1C1C1E" Cursor="Hand" ToolTip="Clear Unpinned History" MouseLeftButtonDown="BtnClearClipboardHistory_MouseLeftButtonDown">
                                    <Path Data="{StaticResource IconTrash}" Fill="#8E8E93" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Row 1: Search Bar (media_1788009864963.png) -->
                            <Border Grid.Row="1" Height="34" CornerRadius="10" Background="#141416" Padding="10,0" Margin="0,0,0,8">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="#8E8E93" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtClipboardSearch" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#37A3DE" FontSize="13" VerticalAlignment="Center" TextChanged="TxtClipboardSearch_TextChanged">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="TextBox">
                                                            <Grid>
                                                                <TextBlock x:Name="Placeholder" Text="Search..." Foreground="#5E5E62" FontSize="13" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                                                                <ScrollViewer x:Name="PART_ContentHost"/>
                                                            </Grid>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="Text" Value="">
                                                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                    <Border x:Name="BtnClearSearch" Grid.Column="2" Width="18" Height="18" CornerRadius="9" Background="#2C2C2E" Cursor="Hand" Visibility="Collapsed" MouseLeftButtonDown="BtnClearSearch_MouseLeftButtonDown">
                                        <Path Data="{StaticResource IconXMark}" Fill="#8E8E93" Width="8" Height="8" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- Row 2: Smooth Scrollable List -->
                            <ScrollViewer x:Name="ClipboardListScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" Height="195" Margin="0,0,0,2" PreviewMouseWheel="ClipboardScrollViewer_PreviewMouseWheel">
                                <Grid VerticalAlignment="Top">
                                    <!-- Empty State Prompt -->
                                    <StackPanel x:Name="ClipboardEmptyPrompt" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,30,0,10" Visibility="Collapsed">
                                        <Path Data="{StaticResource IconClipboard}" Fill="#48484A" Width="36" Height="36" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock x:Name="TxtClipboardEmptyTitle" Text="Clipboard history is empty" Foreground="#8E8E93" FontSize="13.5" FontWeight="Medium" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtClipboardEmptySubtitle" Text="1-9 to paste • Ctrl+C to copy • Click to reuse" Foreground="#555558" FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Items List -->
                                    <StackPanel x:Name="ClipboardItemsStackPanel" VerticalAlignment="Top" Margin="0,0,0,22"/>
                                </Grid>
                            </ScrollViewer>
                        </Grid>

                        <!-- 2. Apple Rich Note / Snippet Composer & Editor View -->
                        <Grid x:Name="ViewNoteEditor" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: Note Editor Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Cancel / Back Button -->
                                <Border x:Name="BtnCancelNoteEdit" Grid.Column="0" Height="28" Padding="10,0" CornerRadius="14" Background="#1C1C1E" Cursor="Hand" ToolTip="Cancel (Esc)" MouseLeftButtonDown="BtnCancelNoteEdit_MouseLeftButtonDown">
                                    <TextBlock Text="Cancel" Foreground="#8E8E93" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Center: Mode Title -->
                                <TextBlock x:Name="TxtNoteEditorHeader" Grid.Column="1" Text="New Note" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Right: Save Button -->
                                <Border x:Name="BtnSaveNoteEdit" Grid.Column="2" Height="28" Padding="14,0" CornerRadius="14" Background="#0A84FF" Cursor="Hand" ToolTip="Save Note (Ctrl+Enter)" MouseLeftButtonDown="BtnSaveNoteEdit_MouseLeftButtonDown">
                                    <TextBlock Text="Save" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>

                            <!-- Row 1: Title Input -->
                            <Border Grid.Row="1" Height="34" CornerRadius="10" Background="#141416" Padding="10,0" Margin="0,0,0,8">
                                <TextBox x:Name="TxtNoteEditTitle" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#37A3DE" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" KeyDown="TxtNoteEdit_KeyDown">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Grid>
                                                            <TextBlock x:Name="Placeholder" Text="Title..." Foreground="#5E5E62" FontSize="13" FontWeight="Normal" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed"/>
                                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Border>

                            <!-- Row 2: Content Multi-line Input -->
                            <Border Grid.Row="2" Height="195" CornerRadius="12" Background="#141416" Padding="10,8" Margin="0,0,0,2">
                                <TextBox x:Name="TxtNoteEditContent" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" CaretBrush="#37A3DE" FontSize="12.5" VerticalAlignment="Stretch" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Hidden" KeyDown="TxtNoteEdit_KeyDown">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Grid>
                                                            <TextBlock x:Name="Placeholder" Text="Type note content here... (Ctrl+Enter to save)" Foreground="#5E5E62" FontSize="12.5" VerticalAlignment="Top" Margin="2,2,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="Text" Value="">
                                                                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- CALL EXPANDED VIEW (When ongoing call is tapped/expanded) -->
                    <Grid x:Name="ViewCallExpandedBody" VerticalAlignment="Stretch" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Info -->
                        <Grid Grid.Row="0" Margin="0,4,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="24" Background="#2C2C2E" ClipToBounds="True">
                                <TextBlock x:Name="TxtCallExpandedAvatar" Text="👤" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8E8E93"/>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock x:Name="TxtCallExpandedName" Text="Tamia Castle" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtCallExpandedSubtitle" Text="01:23 • WhatsApp Call" Foreground="#37C058" FontSize="12.5" FontWeight="Medium" Margin="0,2,0,0"/>
                            </StackPanel>

                            <localCall:CallWaveformControl Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        </Grid>

                        <!-- End Call Action Bar -->
                        <Border Grid.Row="2" Height="44" CornerRadius="22" Background="#FA3532" Cursor="Hand" HorizontalAlignment="Center" Padding="32,0" Margin="0,10,0,2" MouseLeftButtonDown="BtnExpandedEndCall_MouseLeftButtonDown">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource IconCallDecline}" Fill="White" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="End Call" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>

            <!-- 3. DYNAMICNOTCH VOLUME HUD VIEW -->
            <Grid x:Name="VolumeHudView" Margin="16,0,16,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path x:Name="VolumeSpeakerIcon" Grid.Column="0" Data="{StaticResource IconSpeakerHigh}" Fill="White" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="Volume" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Grid Grid.Column="2"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid x:Name="VolumeSliderTrack" Width="60" Height="20" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="VolumeSlider_MouseLeftButtonDown"
                          MouseMove="VolumeSlider_MouseMove"
                          MouseLeftButtonUp="VolumeSlider_MouseLeftButtonUp"
                          VerticalAlignment="Center" Margin="0,0,6,0">
                        <Border Width="52" Height="6" Background="#33FFFFFF" CornerRadius="3" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid HorizontalAlignment="Left">
                                <Border x:Name="VolumeProgressFill" Width="35" Height="6" Background="#FFFFFF" CornerRadius="3"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Height="18" MinWidth="22" ClipToBounds="True" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtVolumeOld" Text="34" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Opacity="0">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleVolumeOld" ScaleY="1"/>
                                    <TranslateTransform x:Name="TransVolumeOld" Y="0"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="TxtVolumeNew" Text="34" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Opacity="1">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleVolumeNew" ScaleY="1"/>
                                    <TranslateTransform x:Name="TransVolumeNew" Y="0"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 4. DYNAMICNOTCH BRIGHTNESS HUD VIEW -->
            <Grid x:Name="BrightnessHudView" Margin="16,0,16,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path x:Name="BrightnessSunIcon" Grid.Column="0" Data="{StaticResource IconSunHigh}" Fill="White" Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="Brightness" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Grid Grid.Column="2"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid x:Name="BrightnessSliderTrack" Width="60" Height="20" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="BrightnessSlider_MouseLeftButtonDown"
                          MouseMove="BrightnessSlider_MouseMove"
                          MouseLeftButtonUp="BrightnessSlider_MouseLeftButtonUp"
                          VerticalAlignment="Center" Margin="0,0,6,0">
                        <Border Width="52" Height="6" Background="#33FFFFFF" CornerRadius="3" ClipToBounds="True" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Grid HorizontalAlignment="Left">
                                <Border x:Name="BrightnessProgressFill" Width="35" Height="6" Background="#FFFFFF" CornerRadius="3"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Height="18" MinWidth="22" ClipToBounds="True" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBrightnessOld" Text="100" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Opacity="0">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleBrightnessOld" ScaleY="1"/>
                                    <TranslateTransform x:Name="TransBrightnessOld" Y="0"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock x:Name="TxtBrightnessNew" Text="100" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Opacity="1">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ScaleBrightnessNew" ScaleY="1"/>
                                    <TranslateTransform x:Name="TransBrightnessNew" Y="0"/>
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 5. DND FOCUS HUD VIEW -->
            <Grid x:Name="DndHudView" Margin="18,0,18,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Data="{StaticResource IconMoon}" Fill="#5E5CE6" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="1" Text="Do Not Disturb" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Grid Grid.Column="2"/>
                <TextBlock x:Name="TxtDndStatus" Grid.Column="3" Text="On" Foreground="#5E5CE6" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>

            <!-- 6. BLUETOOTH / AUDIO DEVICE HUD VIEW (Clean Apple Dynamic Island HUD) -->
            <Grid x:Name="BluetoothHudView" Margin="14,0,14,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Device Icon (34px x 24px) -->
                <Grid x:Name="DeviceIconContainer" Grid.Column="0" Width="36" Height="26" VerticalAlignment="Center" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="BtIconScale" ScaleX="1" ScaleY="1"/>
                            <RotateTransform x:Name="BtIconRotate" Angle="0"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Image x:Name="DeviceIconImage"
                           Width="34" Height="24"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                    <Path x:Name="DeviceIconVector"
                          Data="{StaticResource IconTwsEarbuds}"
                          Stroke="#FFFFFF" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="26" Height="24"
                          Stretch="Uniform"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Visibility="Collapsed"/>
                </Grid>

                <!-- Center: Device Name & Subtitle -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtBtDeviceName" Text="" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtBtSubtitle" Text="Connected" Foreground="#8E8E93" FontSize="11" FontWeight="Medium" Margin="0,1,0,0"/>
                </StackPanel>

                <!-- Right: Battery Ring Gauge OR AirDrop-style Clean Checkmark -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <!-- Compact 24px Battery Gauge -->
                    <Grid x:Name="BatteryGaugeContainer" Visibility="Visible" Width="26" Height="26">
                        <Ellipse Width="24" Height="24" Stroke="#1F00E46C" StrokeThickness="2.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="BtBatteryArc" Stroke="#00E46C" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <TextBlock x:Name="TxtBtBatteryPercent" Text="85" Foreground="#00E46C" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Clean AirDrop-Style Vector Checkmark (26px) with Connecting Arc -->
                    <Grid x:Name="CheckmarkContainer" Visibility="Collapsed" Width="26" Height="26">
                        <Ellipse Width="24" Height="24" Stroke="#1F00E46C" StrokeThickness="2.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="BtConnectingArc" Stroke="#00E46C" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Grid x:Name="BtCheckmarkIcon" Visibility="Collapsed">
                            <Ellipse Width="24" Height="24" Fill="#1F00E46C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Path Data="{StaticResource IconCheckmark}" Fill="#00E46C" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 7.5 AUTHENTIC APPLE AIRDROP INCOMING TRANSFER PROMPT (Matching media_1787977319843.png 1:1) -->
            <Grid x:Name="AirDropIncomingHudView" Margin="20,16,20,16" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Top Section (Left: AirDrop Icon + Sender Info, Right: Photo / File Preview) -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: AirDrop Icon & Sender Details -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <!-- AirDrop Header Row with Official Blue AirDrop SVG Badge -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                            <Grid Width="28" Height="28" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Ellipse Width="28" Height="28" Fill="#1E354A"/>
                                <Path Data="{StaticResource IconAirDropOfficial}" Fill="#37A3DE" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="AirDrop" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Subtitle: "<Sender Name> would like to share <file info>" -->
                        <TextBlock x:Name="TxtAirDropIncomingSender" Text="vivo Y28e 5G would like to share 1 photo" Foreground="#A1A1A6" FontSize="13" FontWeight="Normal" TextWrapping="Wrap" MaxWidth="250" MaxHeight="46" TextTrimming="CharacterEllipsis" LineHeight="17"/>
                    </StackPanel>

                    <!-- Right: Large Rounded Thumbnail Preview (Image or File Icon) -->
                    <Border Grid.Column="1" Width="76" Height="76" CornerRadius="16" Background="#1C1C20" BorderBrush="#25FFFFFF" BorderThickness="1" ClipToBounds="True" VerticalAlignment="Center">
                        <Grid>
                            <Image x:Name="ImgAirDropIncomingPreview" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
                            <StackPanel x:Name="IconAirDropIncomingFallback" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="{StaticResource IconAirDropOfficial}" Fill="#37A3DE" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtAirDropIncomingFileType" Text="FILE" Foreground="#8E8E93" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Row 1: Action Buttons ([ Decline ] & [ Accept ]) -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Decline Button -->
                    <Border x:Name="BtnAirDropDecline" Grid.Column="0" Height="42" Margin="0,0,6,0" CornerRadius="21" Background="#2C2C2E" Cursor="Hand" ToolTip="Decline transfer" MouseLeftButtonDown="BtnAirDropDecline_Click">
                        <TextBlock Text="Decline" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Accept Button -->
                    <Border x:Name="BtnAirDropAccept" Grid.Column="1" Height="42" Margin="6,0,0,0" CornerRadius="21" Background="#0A84FF" Cursor="Hand" ToolTip="Accept transfer" MouseLeftButtonDown="BtnAirDropAccept_Click">
                        <TextBlock Text="Accept" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- 7.6 AUTHENTIC APPLE SCREEN MIRRORING EXPANDED CARD (Matching media_1787986030265.png 1:1) -->
            <Grid x:Name="ScreenMirroringHudView" Margin="20,16,20,16" VerticalAlignment="Top" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Top Section (Left: Blue Screen Share Icon, Center: Screen Mirroring & Host Name, Right: Gray Laptop Icon) -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Blue Screen Mirroring Double Screens Icon -->
                    <Grid Grid.Column="0" Width="36" Height="36" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Path Data="{StaticResource IconScreenShareLeft}" Fill="#37A3DE" Width="28" Height="24" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Center: Title & Subtitle -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Screen Mirroring" Foreground="#FFFFFF" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtScreenMirroringTarget" Text="infinity" Foreground="#8E8E93" FontSize="13" FontWeight="Normal" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Right: Gray Laptop / Display Icon -->
                    <Grid Grid.Column="2" Width="28" Height="28" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconScreenShareRightTarget}" Fill="#8F8F8F" Width="22" Height="15" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- Row 1: Stop Mirroring Button (Matching Mockup: Fill="#1A1C2D", Text="#37A3DE") -->
                <Border x:Name="BtnStopScreenMirroring" Grid.Row="1" Height="42" CornerRadius="21" Background="#1A1C2D" Cursor="Hand" ToolTip="Stop Screen Mirroring" MouseLeftButtonDown="BtnStopScreenMirroring_Click">
                    <TextBlock Text="Stop Mirroring" Foreground="#37A3DE" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <!-- 8. AIRDROP DEVICE PICKER / MACOS SHARE SHEET OVERLAY -->
            <Grid x:Name="AirDropPickerView" Margin="14,10,14,10" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top Header: Official Blue AirDrop SVG, Title, Quick Share & LocalSend Icons, Close Button -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconAirDropOfficial}" Fill="#37A3DE" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="AirDrop" Foreground="#FFFFFF" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Top Right Actions: Quick Share, LocalSend, Close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Quick Share Icon Button -->
                        <Border Width="24" Height="24" CornerRadius="12" Background="#1D2A38" Cursor="Hand" ToolTip="Send via Google Quick Share" MouseLeftButtonDown="BtnAirDropQuickShare_Click" Margin="0,0,6,0">
                            <Path Data="{StaticResource IconQuickShareOfficial}" Fill="#4DA8FF" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- LocalSend Icon Button -->
                        <Border Width="24" Height="24" CornerRadius="12" Background="#173140" Cursor="Hand" ToolTip="Send via LocalSend" MouseLeftButtonDown="BtnAirDropQuickSendApp_Click" Margin="0,0,8,0">
                            <Path Data="{StaticResource IconLocalSendOfficial}" Fill="#38BDF8" Width="13" Height="13" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Dismiss Cross Button -->
                        <Border Width="20" Height="20" CornerRadius="10" Background="#22FFFFFF" Cursor="Hand" ToolTip="Cancel" MouseLeftButtonDown="BtnCloseAirDropPicker_Click">
                            <TextBlock Text="✕" Foreground="#CCFFFFFF" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Subtle Separator Hairline -->
                <Rectangle Grid.Row="1" Height="0.8" Fill="#20FFFFFF" Margin="0,0,0,8"/>

                <!-- Middle 2-Column Body (Left: Devices / Radar, Right: Live macOS Content Preview Card) -->
                <Grid Grid.Row="2" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Available Devices or Searching Radar -->
                    <Grid Grid.Column="0" VerticalAlignment="Center">
                        <!-- Searching State (Apple 3-Ring Radar Wave) -->
                        <StackPanel x:Name="AirDropSearchingContainer" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Visible" Margin="4,0,0,0">
                            <Grid Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Ellipse Width="24" Height="24" Stroke="#37A3DE" StrokeThickness="1.4" Opacity="0.35"/>
                                <Ellipse Width="14" Height="14" Stroke="#37A3DE" StrokeThickness="1.4" Opacity="0.65"/>
                                <Ellipse Width="4.5" Height="4.5" Fill="#37A3DE"/>
                            </Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Searching nearby..." Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold"/>
                                <TextBlock Text="AirDrop, Quick Share, LocalSend" Foreground="#8E8E93" FontSize="10" Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Devices Vertical Scrollable List -->
                        <ScrollViewer x:Name="AirDropDevicesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="120" Focusable="False" Visibility="Collapsed">
                            <ItemsControl x:Name="AirDropDevicesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4" Padding="6,4" CornerRadius="8" Background="#0DFFFFFF" Cursor="Hand"
                                                MouseLeftButtonDown="AirDropDeviceCard_MouseLeftButtonDown"
                                                ToolTip="Tap to send">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15" Background="#1E3E54" BorderBrush="#37A3DE" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Initials}" Foreground="#37A3DE" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Alias}" Foreground="#FFFFFF" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding DisplaySubtitle}" Foreground="#8E8E93" FontSize="9.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- Right Column: macOS Content Live Preview Card (Matching media_1787971226481.png) -->
                    <Border Grid.Column="1" Width="104" Height="118" Margin="12,0,2,0" CornerRadius="8" Background="#1C1C20" BorderBrush="#30FFFFFF" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <!-- Real Image Thumbnail (if Image) -->
                            <Image x:Name="AirDropPickerPreviewImg" Stretch="UniformToFill" Visibility="Collapsed"/>

                            <!-- Document / Note / Link Fallback Preview -->
                            <Grid x:Name="AirDropPickerPreviewDoc" Margin="6" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Path x:Name="AirDropPickerDocIcon" Data="{StaticResource IconNote}" Fill="#37A3DE" Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                    <TextBlock x:Name="TxtPickerFileName" Text="file" Foreground="#FFFFFF" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" TextAlignment="Center"/>
                                    <TextBlock x:Name="TxtPickerFileSize" Text="" Foreground="#8E8E93" FontSize="8.5" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Bottom Footer: Apple Style Cancel Button -->
                <Grid Grid.Row="3" Margin="0,2,0,0">
                    <Border HorizontalAlignment="Right" CornerRadius="6" Background="#28282C" BorderBrush="#40FFFFFF" BorderThickness="0.8" Padding="14,4" Cursor="Hand" ToolTip="Cancel" MouseLeftButtonDown="BtnCloseAirDropPicker_Click">
                        <TextBlock Text="Cancel" Foreground="#E5E5EA" FontSize="11" FontWeight="Medium"/>
                    </Border>
                </Grid>
            </Grid>

            <!-- 7. AIRDROP LIVE TRANSFER HUD VIEW (Exact Figma 1:1 Specs) -->
            <Grid x:Name="AirDropHudView" Margin="18,0,18,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Leading Left: 56x56 Official AirDrop Cyan Icon + Thumbnail Overlay -->
                <Grid Grid.Column="0" Width="56" Height="56" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Ellipse Width="56" Height="56" Fill="#1437A3DE" Stroke="#3037A3DE" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Path Data="{StaticResource IconAirDropOfficial}" Fill="#37A3DE" Width="30" Height="30" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- Bottom Right File Thumbnail Badge -->
                    <Border Width="20" Height="20" CornerRadius="4" Background="#1C1C1E" BorderBrush="#37A3DE" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" ClipToBounds="True">
                        <Image x:Name="AirDropFileThumb" Stretch="UniformToFill"/>
                    </Border>
                </Grid>

                <!-- Center Text Stack -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtAirDropSubtitle" Text="mobile" Foreground="#7EA8C4" FontSize="11" FontWeight="Normal"/>
                    <TextBlock x:Name="TxtAirDropTitle" Text="AirDrop from Chi" Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Trailing Right: 56x56 Progress Ring + Cancel / Completed Checkmark / Failed Cross -->
                <Grid Grid.Column="2" Width="56" Height="56" VerticalAlignment="Center">
                    <!-- In-Progress Container -->
                    <Grid x:Name="AirDropProgressContainer" Visibility="Visible" Width="56" Height="56" Cursor="Hand" ToolTip="Cancel Transfer" MouseLeftButtonDown="BtnAirDropCancel_Click">
                        <!-- Ellipse 35: Track Ring (35% Opacity) -->
                        <Ellipse Width="56" Height="56" Stroke="#37A3DE" StrokeThickness="4.67" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- Ellipse 34: Progress Arc -->
                        <Path x:Name="AirDropProgressArc" Stroke="#37A3DE" StrokeThickness="4.67" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <!-- Rectangle 4: Center Stop / Cancel Pill Square -->
                        <Border Width="22" Height="22" CornerRadius="6.2" Background="#37A3DE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Completed Container (Green Circle with ✓) -->
                    <Grid x:Name="AirDropCompletedContainer" Visibility="Collapsed" Width="56" Height="56" Cursor="Hand" ToolTip="Open Received File" MouseLeftButtonDown="BtnAirDropOpen_Click">
                        <Ellipse Width="56" Height="56" Fill="#173B2A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path Data="{StaticResource IconCheckmark}" Fill="#00E46C" Width="22" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Failed Container (Red Circle with ✕) -->
                    <Grid x:Name="AirDropFailedContainer" Visibility="Collapsed" Width="56" Height="56" Cursor="Hand" ToolTip="Transfer Failed" MouseLeftButtonDown="BtnAirDropCancel_Click">
                        <Ellipse Width="56" Height="56" Fill="#3B1717" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path Data="{StaticResource IconXMark}" Fill="#FF3B30" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 8. CLIPBOARD / SCREENSHOT HUD VIEW (Exact 1:1 Minimalist Pill Matching media_1788011751371.png) -->
            <Grid x:Name="ClipboardHudView" Margin="14,0,14,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Pure Crisp Cyan SVG (Clipboard / Screenshot) -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Path x:Name="ClipboardHudIcon" Data="{StaticResource IconClipboard}" Fill="#37A3DE" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Middle: Clean Spacer (Zero Text, Matching media_1788011751371.png) -->
                <Grid Grid.Column="1"/>

                <!-- Right: Green Progress Ring & Green Tick (Matching media_1788011751371.png) -->
                <Grid Grid.Column="2" Width="22" Height="22" VerticalAlignment="Center">
                    <!-- Progress Container -->
                    <Grid x:Name="ClipboardHudProgressContainer" Visibility="Visible" Width="22" Height="22">
                        <Ellipse Width="22" Height="22" Stroke="#153723" StrokeThickness="2.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="ClipboardHudProgressArc" Stroke="#00E46C" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                    <!-- Completed Checkmark Container (Exact Green Tick Circle from media_1788011751371.png) -->
                    <Grid x:Name="ClipboardHudCompletedContainer" Visibility="Collapsed" Width="22" Height="22">
                        <Ellipse Width="22" Height="22" Fill="#0D2618" Stroke="#174A2B" StrokeThickness="1.2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path Data="{StaticResource IconCheckmark}" Fill="#00E46C" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- 9. AUTHENTIC APPLE MACBOOK CAPS LOCK HUD VIEW (Matching media_1788018659285.png 1:1) -->
            <Grid x:Name="CapsLockHudView" Margin="14,0,14,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Exact Physical Apple MacBook Caps Lock Keycap Vector -->
                <Grid Grid.Column="0" Width="36" Height="25" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- Bottom Keycap 3D Bevel/Base -->
                    <Border Width="36" Height="23" CornerRadius="6" Background="#0A0A0C" VerticalAlignment="Bottom" Margin="0,2,0,0"/>
                    <!-- Top Keycap Surface -->
                    <Border x:Name="CapsLockKeycapSurface" Width="35" Height="22" CornerRadius="5.5" Background="#1C1C1E" BorderBrush="#38383A" BorderThickness="1" VerticalAlignment="Top">
                        <!-- Apple Caps Lock Upward Arrow Symbol (⇪) in original bottom-left position -->
                        <Path x:Name="CapsLockArrowIcon" Data="M 3,6 L 6.5,2 L 10,6 L 8,6 L 8,7.5 L 5,7.5 L 5,6 Z M 3,9 L 10,9 L 10,10.2 L 3,10.2 Z" Fill="#FFFFFF" Width="10" Height="10" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4,0,0,3.5"/>
                    </Border>
                </Grid>

                <!-- CENTER: Title Text -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Caps Lock" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- RIGHT: Status Tag "On" (Apple Green) / "Off" (Apple Gray) -->
                <TextBlock x:Name="TxtCapsLockStatus" Grid.Column="2" Text="On" Foreground="#30D158" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>

            <!-- 10. INCOMING CALL HUD BANNER (Exact Match to User SVG 1: 367x86) -->
            <Grid x:Name="IncomingCallHudView" Width="367" Height="86" VerticalAlignment="Center" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Circular Avatar (56x56) -->
                <Grid Grid.Column="0" Width="56" Height="56" Margin="16,0,12,0" VerticalAlignment="Center">
                    <Border CornerRadius="28" Background="#2C2C2E" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="ImgIncomingCallAvatar" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="TxtIncomingCallInitial" Text="👤" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#8E8E93"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Center: Caller Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock x:Name="TxtIncomingCallSubtitle" Text="WhatsApp Audio" Foreground="#A4A4A9" FontSize="12.5" FontWeight="Medium"/>
                    <TextBlock x:Name="TxtIncomingCallName" Text="Tamia Castle" Foreground="#FFFFFF" FontSize="16.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Right: Action Buttons (Decline & Accept) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <!-- Red Decline Button (#FA3532) -->
                    <Border x:Name="BtnIncomingCallDecline" Width="49" Height="49" CornerRadius="24.5" Background="#FA3532" Cursor="Hand" Margin="0,0,8,0" ToolTip="Decline Call" MouseLeftButtonDown="BtnIncomingCallDecline_MouseLeftButtonDown">
                        <Path Data="{StaticResource IconCallDecline}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Green Accept Button (#37C058) -->
                    <Border x:Name="BtnIncomingCallAccept" Width="49" Height="49" CornerRadius="24.5" Background="#37C058" Cursor="Hand" ToolTip="Accept Call" MouseLeftButtonDown="BtnIncomingCallAccept_MouseLeftButtonDown">
                        <Path Data="{StaticResource IconCallAccept}" Fill="White" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

        </Grid>
    </Grid>
</Window>
